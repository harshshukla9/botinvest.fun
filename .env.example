# botcrates talks to live BOT Chain + Lumora. There is no demo/simulation mode.
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
SESSION_SECRET=local-dev-only-secret-change-me-0001

# testnet (968) is where Lumora currently publishes. Use mainnet (677) when ready.
BOT_CHAIN_NETWORK=testnet
BOT_CHAIN_RPC_URL=https://rpc.bohr.life

# Official Lumora REST. On-chain reads use CommodityConsumer on the same network.
LUMORA_API_BASE=https://botchain-commodity-oracle.vercel.app
LUMORA_CONSUMER_ADDRESS=0x5E6658ac6cBC9b0109C28BED00bC4Af0F0A3f1CD
LUMORA_ORACLE_ADDRESS=0x90Dfd581393104EAe03Fd349b4867A7E8F51313b

# Production persistence. Leave unset for in-memory local development.
DATABASE_URL=

# Optional: extra BDEX token addresses (comma-separated) to always include.
BDEX_EXTRA_TOKENS=
